<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.dev.yjjeon.calendar.mapper.UserMapper">

    <select id="findByUsername" parameterType="string" resultType="io.github.dev.yjjeon.calendar.model.entity.User">
        SELECT id, username, password, name, created_at
        FROM user
        WHERE username = #{username}
    </select>

    <insert id="insert" parameterType="io.github.dev.yjjeon.calendar.model.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, name)
        VALUES (#{username}, #{password}, #{name})
    </insert>

</mapper>
